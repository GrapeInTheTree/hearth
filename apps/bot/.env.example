# ────────────────────────────────────────────────────────────────────
# Discord — required
# ────────────────────────────────────────────────────────────────────
# Bot token from Discord Developer Portal → Bot → Reset Token.
# NEVER commit a real token. This repo is PUBLIC.
DISCORD_TOKEN=

# Application ID (snowflake) from Developer Portal → General Information.
DISCORD_APP_ID=

# Optional: register slash commands to a single dev guild for instant updates.
# Without this, commands register globally (~1h propagation).
DISCORD_DEV_GUILD_ID=

# ────────────────────────────────────────────────────────────────────
# Branding — white-label per-deployment
# ────────────────────────────────────────────────────────────────────
BOT_NAME=Hearth
# Hex color must be quoted — `#` would otherwise be parsed as start-of-comment
BOT_BRAND_COLOR="#FF6B35"
BOT_ICON_URL=
BOT_FOOTER_TEXT=
BOT_SUPPORT_URL=
BOT_LOCALE=en

# ────────────────────────────────────────────────────────────────────
# Database — required from Phase 1 onward
# ────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://bot:bot@localhost:5432/discord_bot?schema=public

# ────────────────────────────────────────────────────────────────────
# Tickets — optional. Per-type config (panel channel, active category,
# support roles, etc.) is operator-driven via /panel + /panel ticket-type
# slash commands.
# ────────────────────────────────────────────────────────────────────
# Category that closed tickets are moved to. Can also be set via
# /setup archive-category.
TICKET_ARCHIVE_CATEGORY_ID=
# Channel that receives audit-log embeds when tickets are deleted. Can
# also be set via /setup log-channel.
BOT_LOG_CHANNEL_ID=

# ────────────────────────────────────────────────────────────────────
# X-watcher (X / Twitter → Discord post mirror)
# ────────────────────────────────────────────────────────────────────
# Which feed backend supplies posts. Today only "none" is valid — the
# feature is wired end-to-end but mirrors NOTHING until a real backend
# (official X API / RSS) is implemented. The bot boots fine with "none";
# the poller just logs "idle — no feed source configured".
#
# When a real source lands it adds a new value here (e.g. "xapi") in
# config/env.ts's X_FEED_SOURCE enum + a branch in
# services/xFeedSourceFactory.ts + the token env below.
X_FEED_SOURCE=none
# How often (seconds) the poller checks each enabled watcher for new
# posts. Range 30–3600; default 300 (5 min). Optional.
X_WATCHER_POLL_INTERVAL_SEC=300
# (FUTURE — not read yet) The credential the real source will need, e.g.
# the X API bearer token for X_FEED_SOURCE=xapi. The source-implementation
# PR introduces the actual var name + wires it into the factory. Listed
# here so deployers know a secret will be required at that point.
# X_API_BEARER_TOKEN=

# ────────────────────────────────────────────────────────────────────
# Observability
# ────────────────────────────────────────────────────────────────────
LOG_LEVEL=info
SENTRY_DSN=

# ────────────────────────────────────────────────────────────────────
# Server
# ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ────────────────────────────────────────────────────────────────────
# Internal API — used by apps/dashboard to call the bot
# ────────────────────────────────────────────────────────────────────
# Shared secret. MUST match the dashboard's INTERNAL_API_TOKEN. Generate
# with: openssl rand -hex 32. Required in production; without it the
# bot's /internal/* routes return 503 ("INTERNAL_API_TOKEN is not
# configured"). /healthz remains accessible without auth either way.
INTERNAL_API_TOKEN=
